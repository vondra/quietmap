  "derived": {
    "$doc": "Commensurability-axis tags (catalog §11) — computed by the coverage report from structured fixture fields, never authored in `tags`.",
    "metric_lden": "commensurability.metric_variant in {lden, lden_band}",
    "metric_ldn_dnl": "commensurability.metric_variant == ldn_dnl",
    "metric_cnel": "commensurability.metric_variant == cnel",
    "metric_period_split": "commensurability.metric_variant == period_split (ld/le/ln published)",
    "metric_ln_only": "fixture metric_field == ln",
    "receiver_facade": "commensurability.receiver_convention == facade",
    "receiver_free_field": "commensurability.receiver_convention == free_field",
    "receiver_roof": "commensurability.receiver_convention == roof",
    "receiver_nmt_pole": "commensurability.receiver_convention == nmt_pole",
    "coord_uncertainty_lt50m": "commensurability.coord_uncertainty_m < 50",
    "coord_uncertainty_lt300m": "50 <= commensurability.coord_uncertainty_m < 300",
    "coord_uncertainty_gt300m": "commensurability.coord_uncertainty_m >= 300",
    "total_ambient": "commensurability.dominance == total_ambient",
    "event_classified": "commensurability.dominance == event_classified"
  },
  "metric_variants": {
    "$doc": "commensurability.metric_variant enum — the external anchor's native metric. `band_capable`: an external.band in the fixture's metric_field may be authored (metric honesty: never fake-converted). Non-band-capable variants keep external.band null; their Δ story lives in tolerance_note.",
    "lden": { "band_capable": true },
    "lden_band": { "band_capable": true, "note": "official-map class band (e.g. SHM 60–65)" },
    "period_split": { "band_capable": true, "note": "ld/le/ln published — band in the fixture's metric_field" },
    "ln": { "band_capable": true },
    "ldn_dnl": { "band_capable": true, "note": "US — no evening penalty; compared as-is, variant recorded" },
    "cnel": { "band_capable": true, "note": "CA — evening 19–22; ≈Lden sub-dB, compared as-is" },
    "laeq_windows": { "band_capable": false, "note": "hygiene day/night windows (CZ DEN/NOC 06–22/22–06, CH Tag 06–22, DIN day/night) — not END periods" },
    "laeq_24h": { "band_capable": false, "note": "metric honesty: LAeq,24h-only stations are not ingested as anchors; legacy plausibility only" },
    "laeq_spot": { "band_capable": false, "note": "single-campaign operational LAeq (EIA/accredited protocol)" },
    "laeq_spot_derived_lden": { "band_capable": true, "note": "spot LAeq → Lden via a documented per-case offset; cite the derivation in external.annualization_method" },
    "input_data": { "band_capable": false, "note": "AADT/train-count/facility-register anchor — probes input data, not received level" },
    "plausibility": { "band_capable": true, "note": "documented literature/land-type envelope (NPS quiet-land, BS 4142 practice class)" }
  },
  "dominance_values": {
    "$doc": "commensurability.dominance enum — how source dominance at the anchor is established INDEPENDENTLY of the model (asymmetric dominance rule). total_ambient anchors bound the model only from above: model ≤ measured + U; below-band deltas are unattributable, never model error.",
    "total_ambient": "station measures everything; upper-bound check only",
    "event_classified": "network classifies events to the source (airport NMTs, flight-correlated)",
    "near_source": "geometry makes the tagged source dominant beyond doubt",
    "map_crosscheck": "official per-source map layer provides the source split"
  },
