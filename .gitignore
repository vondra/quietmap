node_modules/
dist/
/server/dist
/server/dist.next
/server/dist.previous
/.server-dist/
/.server-deps/
/.release.lock
/frontend/dist.stage/
/frontend/dist.check/
/frontend/dist.previous/
/frontend/dist.previous.older/
/frontend/test-results/
/frontend/playwright-report/
*.log
.env

# One-time download caches for build scripts (e.g. Natural Earth GeoJSON).
scripts/cache/

# Data - large binary files, not in git
/data

# Build artifacts
*.tsbuildinfo
target/
# Cargo workspace shims are symlinks named `target`, and git's `target/`
# rule matches directories only — so name them here explicitly.
engine/*/target
*.node
pipeline/lib/*.js
pipeline/lib/*.d.ts

# Runtime artifacts
.claude/scheduled_tasks.lock
nohup.out
server.out
server.err
test.js
server/public/debug-*.png*
pipeline/_*-download.py
pipeline/cz_hexes.mjs
benchmarks/.tmp-telemetry.jsonl
.playwright-mcp/

# cluster worker list (local, per-machine)
scripts/hosts
__pycache__/
logs/
.data-hub-token
.data-hub-key.pem
scripts/data-hub-cert.pem
scripts/.host-costs.lock
scripts/.hub-env
scripts/.hosts.lock
# fleet provisioning state (local, per-machine — same category as scripts/hosts above)
scripts/world/fleet.sqlite*
# fleet reconciler state (supervision v3 — workers.sqlite, single writer = reconcile.mjs)
scripts/world/workers.sqlite*
.gemini/
# Bruitparif Rumeur licence unverified for the API (adapter header) — local-only until confirmed
benchmarks/validation/snapshots/bruitparif-*.json
